+  return MaterialApp(
+    theme: ThemeData(
+      fontFamily: Platform.environment['VENERA_VISUAL_FONT'] == null
+          ? null
+          : 'VisualFixture',
+      colorScheme: ColorScheme.fromSeed(
+        seedColor: seed,
+        brightness: brightness,
+      ),
+    ),
+    builder: (context, child) => MediaQuery(
+      data: MediaQuery.of(
+        context,
+      ).copyWith(textScaler: TextScaler.linear(scale)),
