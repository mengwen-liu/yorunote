+      child: Scaffold(
+        body: Builder(
+          builder: (context) => CustomScrollView(
+            slivers: [
+              SliverToBoxAdapter(
+                child: HomeSearchEntry(
+                  label: 'Search'.tl,
+                  onTap: onSearch ?? () {},
+                ),
+              ),
+              SliverToBoxAdapter(
+                child: HomeHistorySection(
+                  count: history,
+                  onViewAll: onHistory ?? () {},
+                  onSearch: onSearch ?? () {},
+                  recentComics: history == 0
