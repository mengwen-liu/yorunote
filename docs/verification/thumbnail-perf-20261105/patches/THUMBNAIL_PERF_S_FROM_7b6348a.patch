new file mode 100644
index 0000000000000000000000000000000000000000..14c2f33c1882fd58aad2166f6cf243cd1f7ad2f5
--- /dev/null
+++ b/lib/network/request_limiter.dart
@@ -0,0 +1,85 @@
+import 'dart:async';
+import 'dart:collection';
+
+/// Thrown by [RequestLimiter.acquire] when a waiter was cancelled before it
+/// got a slot.
+class RequestCancelledException implements Exception {
+  const RequestCancelledException();
+
+  @override
+  String toString() => 'RequestCancelledException';
+}
+
+/// Lets at most [maxConcurrent] requests run at the same time.
+///
+/// Waiters are served in FIFO order. A released slot is handed to the next
+/// waiter right away (no polling). Waiters whose [acquire] `isCancelled`
+/// callback returns true when their turn comes are skipped, so cancelled loads
+/// never hold or lose a slot.
+class RequestLimiter {
+  RequestLimiter(this.maxConcurrent) : assert(maxConcurrent > 0);
+
+  final int maxConcurrent;
+
+  int _active = 0;
+
+  final _waiters = Queue<_Waiter>();
+
+  /// Number of slots in use.
+  int get active => _active;
+
+  /// Number of waiters, including cancelled ones not yet skipped.
+  int get waiting => _waiters.length;
+
+  /// Waits for a free slot and returns the function that gives it back.
+  ///
+  /// The returned function must be called once the request has finished,
+  /// failed or been abandoned; calling it again has no effect.
+  Future<void Function()> acquire({bool Function()? isCancelled}) {
+    if (_active < maxConcurrent && _waiters.isEmpty) {
+      _active++;
+      return Future.value(_releaser());
+    }
+    final waiter = _Waiter(isCancelled);
+    _waiters.add(waiter);
+    return waiter.completer.future;
+  }
+
+  void Function() _releaser() {
+    var released = false;
+    return () {
+      if (released) return;
+      released = true;
+      _active--;
+      _grantNext();
+    };
+  }
+
+  void _grantNext() {
+    while (_active < maxConcurrent && _waiters.isNotEmpty) {
+      final waiter = _waiters.removeFirst();
+      if (waiter.cancelled) {
+        waiter.completer.completeError(const RequestCancelledException());
+        continue;
+      }
+      _active++;
+      waiter.completer.complete(_releaser());
+    }
+  }
+}
+
+class _Waiter {
+  _Waiter(this.isCancelled);
+
+  final bool Function()? isCancelled;
+
+  final completer = Completer<void Function()>();
+
+  bool get cancelled {
+    try {
+      return isCancelled?.call() ?? false;
+    } catch (_) {
+      return false;
+    }
+  }
+}
diff --git a/test/network/request_limiter_test.dart b/test/network/request_limiter_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..23b8d7950108f6e4eb4af742833c54d82b68d7fd
--- /dev/null
+++ b/test/network/request_limiter_test.dart
@@ -0,0 +1,116 @@
+// Unit tests of RequestLimiter, the event-driven limit of cover requests.
+// No timers are used: a waiter must get a freed slot within microtasks.
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:venera/network/images.dart';
+import 'package:venera/network/request_limiter.dart';
+
+/// Runs pending microtasks only; a timer-based (polling) hand-off would not
+/// complete here.
+Future<void> _microtasks() async {
+  for (var i = 0; i < 10; i++) {
+    await Future<void>.value();
+  }
+}
+
+void main() {
+  test('cover requests are limited to 8', () {
+    expect(ImageDownloader.maxCoverRequests, 8);
+    expect(ImageDownloader.coverRequestLimiter.maxConcurrent, 8);
+  });
+
+  test('grants up to the limit, then hands slots over in FIFO order', () async {
+    final limiter = RequestLimiter(2);
+    final a = await limiter.acquire();
+    final b = await limiter.acquire();
+    expect(limiter.active, 2);
+
+    final order = <String>[];
+    final c = limiter.acquire().then((r) {
+      order.add('c');
+      return r;
+    });
+    final d = limiter.acquire().then((r) {
+      order.add('d');
+      return r;
+    });
+    await _microtasks();
+    expect(order, isEmpty);
+    expect(limiter.waiting, 2);
+
+    a();
+    await _microtasks();
+    expect(order, ['c']);
+    expect(limiter.active, 2);
+
+    b();
+    await _microtasks();
+    expect(order, ['c', 'd']);
+    (await c)();
+    (await d)();
+    expect(limiter.active, 0);
+    expect(limiter.waiting, 0);
+  });
+
+  test('a cancelled waiter is skipped and takes no slot', () async {
+    final limiter = RequestLimiter(1);
+    final first = await limiter.acquire();
+    var cancelled = false;
+    final skipped = limiter.acquire(isCancelled: () => cancelled);
+    final next = limiter.acquire();
+    cancelled = true;
+
+    first();
+    await expectLater(skipped, throwsA(isA<RequestCancelledException>()));
+    final release = await next;
+    expect(limiter.active, 1);
+    release();
+    expect(limiter.active, 0);
+  });
+
+  test('releasing twice frees only one slot', () async {
+    final limiter = RequestLimiter(1);
+    final release = await limiter.acquire();
+    final waiter = limiter.acquire();
+    release();
+    release();
+    final second = await waiter;
+    expect(limiter.active, 1);
+    final third = limiter.acquire();
+    await _microtasks();
+    expect(limiter.waiting, 1, reason: 'the double release granted nothing');
+    second();
+    (await third)();
+    expect(limiter.active, 0);
+  });
+
+  test('a failing isCancelled callback does not lose the slot', () async {
+    final limiter = RequestLimiter(1);
+    final first = await limiter.acquire();
+    final waiter = limiter.acquire(isCancelled: () => throw StateError('x'));
+    first();
+    (await waiter)();
+    expect(limiter.active, 0);
+  });
+
+  test('slots come back after work fails', () async {
+    final limiter = RequestLimiter(3);
+    Future<void> failingWork() async {
+      final release = await limiter.acquire();
+      try {
+        await Future<void>.value();
+        throw Exception('request failed');
+      } finally {
+        release();
+      }
+    }
+
+    final results = await Future.wait([
+      for (var i = 0; i < 10; i++)
+        failingWork().then((_) => 0, onError: (_) => 1),
+    ]);
+    expect(results.reduce((a, b) => a + b), 10);
+    expect(limiter.active, 0);
+    expect(limiter.waiting, 0);
+  });
+}
