diff --git a/test/network/thumbnail_cover_queue_test.dart b/test/network/thumbnail_cover_queue_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..ee8fd33040e3c9f19eabf7902e5f1732bb1bc824
