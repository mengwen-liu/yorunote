+      );
+      expect(await cached.result, isNull, reason: 'shown while paused');
+      expect(server.activeImages, 8);
+      await _get('${server.baseUrl}/__control/release');
+      expect(
+        await Future.wait(paused.map((r) => r.result)),
+        everyElement(isNull),
+      );
+      for (final r in [...paused, cached]) {
+        r.dispose();
+      }
+    });
+  }, skip: _skip);
+
+  testWidgets('chapter pages load through ReaderImageProvider', (tester) async {
+    await tester.runAsync(() async {
+      final pages = (await source.loadComicPages!('c03', '1')).data;
+      final r = Resolution(
+        ReaderImageProvider(pages.first, source.key, 'c03', '1', 1),
+      );
+      expect(await r.result, isNull);
+      r.dispose();
+      expect(server.count('/img/page/c03/1/1.png'), 1);
+    });
+  }, skip: _skip);
+}
+
+/// Calls a control endpoint over real HTTP (rhttp). dart:io's HttpClient is
+/// replaced by a fake in flutter tests, so it is not used here.
+Future<void> _get(String url) async {
+  final res = await AppDio().get<String>(
+    url,
+    options: Options(responseType: ResponseType.plain),
+  );
+  expect(res.statusCode, 200);
+}
diff --git a/test/network/thumbnail_cover_cancel_test.dart b/test/network/thumbnail_cover_cancel_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..663bba9fac58ee34a4888459dee57722df6e4d52
--- /dev/null
+++ b/test/network/thumbnail_cover_cancel_test.dart
@@ -0,0 +1,415 @@
+// Cancellation of cover loads through the real provider path:
+// ImageProvider.resolve -> CachedImageProvider / HistoryImageProvider ->
+// shared cover load -> RequestLimiter -> AppDio -> RHttpAdapter -> rhttp.
+//
+// The server hands every request to the test as a raw socket, so the test
+// decides when headers and body bytes are sent, and sees whether the client
+// closed the connection. A load is cancelled the way the app cancels it: the
+// image is evicted from ImageCache and the next frame releases it.
+// Timeouts only turn a hang into a failure; they never decide the order.
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart' show FlutterError;
+import 'package:flutter/painting.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:venera/foundation/image_provider/cached_image.dart';
+import 'package:venera/foundation/image_provider/history_image_provider.dart';
+import 'package:venera/network/images.dart';
+
+import 'raw_image_server.dart';
+import 'thumbnail_test_support.dart';
+
+const _limit = 8;
+const _closeTimeout = Duration(seconds: 10);
+
+void main() {
+  final unused = CoverServer();
+  final server = RawImageServer();
+  final src = testSource('thumb_cancel_src');
+
+  setUpAll(() async {
+    await initCoverTestEnvironment(unused, sources: [src]);
+    if (hasNativeHttp) await server.start();
+  });
+
+  tearDownAll(() async {
+    await unused.stop();
+    if (hasNativeHttp) await server.stop();
+  });
+
+  setUp(() => PaintingBinding.instance.imageCache.clear());
+
+  String path(String name, {RawMode mode = RawMode.immediate, int shade = 0}) {
+    final p = '/c/$name.png';
+    server.images[p] = png(shade, width: 64, height: 64);
+    server.modes[p] = mode;
+    return p;
+  }
+
+  CachedImageProvider cover(String p, {String cid = 'k', bool fb = false}) =>
+      CachedImageProvider(
+        server.url(p),
+        sourceKey: src.key,
+        cid: cid,
+        fallbackToLocalCover: fb,
+      );
+
+  /// Polls a plain counter until it holds (no server event to wait on).
+  Future<void> eventually(bool Function() condition, String what) async {
+    final sw = Stopwatch()..start();
+    while (!condition()) {
+      if (sw.elapsed > const Duration(seconds: 10)) {
+        fail('timed out waiting for: $what');
+      }
+      await Future<void>.delayed(const Duration(milliseconds: 5));
+    }
+  }
+
+  int activeSlots() => ImageDownloader.coverRequestLimiter.active;
+
+  /// Leaves no held request or busy slot behind from an earlier test.
+  Future<void> reset() async {
+    await server.releaseAll();
+    await eventually(() => activeSlots() == 0, 'idle limiter');
+    PaintingBinding.instance.imageCache.clear();
+  }
+
+  /// ImageCache gives up evicted images after the next frame, as in the app.
+  Future<void> frame(WidgetTester tester) async {
+    tester.binding.scheduleFrame();
+    await tester.pump();
+  }
+
+  /// BaseImageProvider reports (silently in the app) a stop error for a
+  /// cancelled load; only that error is ignored here.
+  Future<void> ignoringStopErrors(Future<void> Function() body) async {
+    final previous = FlutterError.onError;
+    FlutterError.onError = (details) {
+      if (details.exception.toString().contains('ImageLoadingStopException')) {
+        return;
+      }
+      previous?.call(details);
+    };
+    try {
+      await body();
+    } finally {
+      FlutterError.onError = previous;
+    }
+  }
+
+  testWidgets('A: a request cancelled before its headers is torn down when '
+      'they arrive, and only then frees its slot', (tester) async {
+    // Tearing a request down while it waits for its headers is not safe
+    // with rhttp 0.15.1 (see RHttpAdapter.fetch), so it stays open and keeps
+    // its slot until the headers arrive; then it is closed at once.
+    await ignoringStopErrors(() async {
+      late List<Resolution> stuck;
+      late List<String> stuckPaths;
+      await tester.runAsync(() async {
+        await reset();
+        stuckPaths = [
+          for (var i = 0; i < _limit; i++)
+            path('a-stuck-$i', mode: RawMode.holdHeaders),
+        ];
+        stuck = [for (final p in stuckPaths) Resolution(cover(p))];
+        await server.until(() => stuckPaths.every((p) => server.count(p) == 1));
+        expect(activeSlots(), _limit);
+        for (final r in stuck) {
+          r.cancel();
+        }
+      });
+      await frame(tester);
+      await tester.runAsync(() async {
+        // Still waiting for headers: open, and the slots stay accounted for.
+        await Future<void>.delayed(const Duration(milliseconds: 300));
+        for (final p in stuckPaths) {
+          expect(server.heldFor(p).single.isClosedByClient, isFalse);
+        }
+        expect(activeSlots(), _limit);
+        final healthyPath = path('a-healthy', shade: 9);
+        final healthy = Resolution(cover(healthyPath));
+        // Headers arrive (the body is held back): each request must be
+        // closed by the client without reading the rest.
+        for (final p in stuckPaths) {
+          final h = server.heldFor(p).single;
+          await h.sendHeadersAndStall();
+          await h.closedByClient.timeout(
+            _closeTimeout,
+            onTimeout: () => fail('request $p still open after its headers'),
+          );
+          expect(h.isClosedByClient, isTrue);
+        }
+        expect(await healthy.result, isNull);
+        healthy.dispose();
+        expect(server.count(healthyPath), 1);
+        await eventually(() => activeSlots() == 0, 'slots returned');
+        expect(stuck.every((r) => !r.isDone), isTrue);
+      });
+    });
+  }, skip: !hasNativeHttp);
+
+  testWidgets(
+    'B: a response stalled inside the body is torn down on cancel',
+    (tester) async {
+      await ignoringStopErrors(() async {
+        late Resolution r;
+        late String p;
+        await tester.runAsync(() async {
+          await reset();
+          p = path('b-stall', mode: RawMode.stallBody, shade: 20);
+          final firstChunk = Completer<void>();
+          r = Resolution(cover(p));
+          final chunks = ImageStreamListener(
+            (_, _) {},
+            onChunk: (_) {
+              if (!firstChunk.isCompleted) firstChunk.complete();
+            },
+          );
+          r.stream.addListener(chunks);
+          // Headers and the first half of the body have reached the provider.
+          await firstChunk.future.timeout(const Duration(seconds: 20));
+          expect(activeSlots(), 1);
+          r.stream.removeListener(chunks);
+          r.cancel();
+        });
+        await frame(tester);
+        await tester.runAsync(() async {
+          final h = server.heldFor(p).single;
+          await h.closedByClient.timeout(
+            _closeTimeout,
+            onTimeout: () => fail('stalled body still open after cancel'),
+          );
+          expect(h.isClosedByClient, isTrue);
+          await eventually(() => activeSlots() == 0, 'slot returned');
+          expect(r.isDone, isFalse);
+        });
+      });
+    },
+    skip: !hasNativeHttp,
+  );
+
+  testWidgets(
+    'C: queued cancel, error and success return each slot once',
+    (tester) async {
+      await ignoringStopErrors(() async {
+        late List<String> heldPaths;
+        late List<Resolution> held;
+        late Resolution q0, q1, qErr, qOk;
+        late String p0, p1, pErr, pOk;
+        await tester.runAsync(() async {
+          await reset();
+          heldPaths = [
+            for (var i = 0; i < _limit; i++)
+              path('c-held-$i', mode: RawMode.holdHeaders, shade: 30 + i),
+          ];
+          held = [for (final p in heldPaths) Resolution(cover(p))];
+          await server.until(
+            () => heldPaths.every((p) => server.count(p) == 1),
+          );
+          p0 = path('c-q0');
+          p1 = path('c-q1');
+          pErr = path('c-qerr', mode: RawMode.status);
+          server.statusCodes[pErr] = 500;
+          pOk = path('c-qok', shade: 40);
+          q0 = Resolution(cover(p0));
+          q1 = Resolution(cover(p1));
+          qErr = Resolution(cover(pErr));
+          qOk = Resolution(cover(pOk));
+          await eventually(
+            () => ImageDownloader.coverRequestLimiter.waiting >= 4,
+            'four queued loads',
+          );
+          q0.cancel();
+          q1.cancel();
+        });
+        await frame(tester);
+        await tester.runAsync(() async {
+          for (final p in heldPaths) {
+            await server.heldFor(p).single.release();
+          }
+          expect(
+            await Future.wait(held.map((r) => r.result)),
+            everyElement(isNull),
+          );
+          expect(await qOk.result, isNull);
+          expect(await qErr.result, isNotNull);
+          expect(server.count(p0), 0, reason: 'cancelled while queued');
+          expect(server.count(p1), 0, reason: 'cancelled while queued');
+          await eventually(() => activeSlots() == 0, 'all slots back');
+          expect(ImageDownloader.coverRequestLimiter.waiting, 0);
+          for (final r in [...held, qOk, qErr]) {
+            r.dispose();
+          }
+        });
+      });
+    },
+    skip: !hasNativeHttp,
+    timeout: const Timeout(Duration(minutes: 2)),
+  );
+
+  testWidgets(
+    'D1: one cancelled consumer does not stop a shared request',
+    (tester) async {
+      await ignoringStopErrors(() async {
+        late Resolution tile;
+        late Resolution history;
+        late String p;
+        await tester.runAsync(() async {
+          await reset();
+          p = path('d1-shared', mode: RawMode.holdHeaders, shade: 50);
+          final url = server.url(p);
+          tile = Resolution(
+            CachedImageProvider(url, sourceKey: src.key, cid: 'd1'),
+          );
+          history = Resolution(
+            HistoryImageProvider(testHistory('d1', src, url)),
+          );
+          await server.until(() => server.count(p) == 1);
+          tile.cancel();
+        });
+        await frame(tester);
+        await tester.runAsync(() async {
+          final h = server.heldFor(p).single;
+          expect(h.isClosedByClient, isFalse);
+          await h.release();
+          expect(await history.result, isNull);
+          expect(tile.isDone, isFalse);
+          expect(server.count(p), 1);
+          history.dispose();
+        });
+      });
+    },
+    skip: !hasNativeHttp,
+  );
+
+  testWidgets(
+    'D2: a shared request ends when all its consumers cancel',
+    (tester) async {
+      await ignoringStopErrors(() async {
+        late String p;
+        await tester.runAsync(() async {
+          await reset();
+          p = path('d2-shared', mode: RawMode.holdHeaders, shade: 60);
+          final url = server.url(p);
+          final a = Resolution(
+            CachedImageProvider(url, sourceKey: src.key, cid: 'd2'),
+          );
+          final b = Resolution(
+            HistoryImageProvider(testHistory('d2', src, url)),
+          );
+          await server.until(() => server.count(p) == 1);
+          a.cancel();
+          b.cancel();
+        });
+        await frame(tester);
+        await tester.runAsync(() async {
+          final h = server.heldFor(p).single;
+          await h.sendHeadersAndStall();
+          await h.closedByClient.timeout(
+            _closeTimeout,
+            onTimeout: () => fail('shared request still open'),
+          );
+          expect(h.isClosedByClient, isTrue);
+          await eventually(() => activeSlots() == 0, 'slot returned');
+        });
+      });
+    },
+    skip: !hasNativeHttp,
+  );
+
+  testWidgets(
+    'D3: a consumer arriving after all others cancelled starts anew',
+    (tester) async {
+      await ignoringStopErrors(() async {
+        late String p;
+        late Resolution late_;
+        await tester.runAsync(() async {
+          await reset();
+          p = path('d3-shared', mode: RawMode.holdHeaders, shade: 70);
+          final url = server.url(p);
+          final a = Resolution(
+            CachedImageProvider(url, sourceKey: src.key, cid: 'd3'),
+          );
+          final b = Resolution(
+            HistoryImageProvider(testHistory('d3', src, url)),
+          );
+          await server.until(() => server.count(p) == 1);
+          a.cancel();
+          b.cancel();
+        });
+        await frame(tester);
+        await tester.runAsync(() async {
+          // Joins right after the cancellation, before anything is released.
+          late_ = Resolution(
+            CachedImageProvider(
+              server.url(p),
+              sourceKey: src.key,
+              cid: 'd3',
+              fallbackToLocalCover: true,
+            ),
+          );
+          // It must not join the abandoned request: a new one goes out.
+          await server.until(() => server.count(p) == 2);
+          final old = server.heldFor(p).first;
+          final fresh = server.heldFor(p).last;
+          await old.sendHeadersAndStall();
+          await old.closedByClient.timeout(
+            _closeTimeout,
+            onTimeout: () => fail('abandoned request still open'),
+          );
+          expect(old.isClosedByClient, isTrue);
+          expect(fresh.isClosedByClient, isFalse, reason: 'not cancelled');
+          await fresh.release();
+          expect(await late_.result, isNull);
+          late_.dispose();
+          await eventually(() => activeSlots() == 0, 'slots returned');
+        });
+      });
+    },
+    skip: !hasNativeHttp,
+  );
+
+  testWidgets(
+    'E: cancelling while headers arrive never aborts the process',
+    (tester) async {
+      // rhttp 0.15.1 aborts the process when a request is dropped while its
+      // header callback is in flight; loads cancelled just as their headers
+      // arrive must be handled without such a drop.
+      await ignoringStopErrors(() async {
+        for (var round = 0; round < 20; round++) {
+          late List<String> ps;
+          late List<Resolution> rs;
+          await tester.runAsync(() async {
+            await reset();
+            ps = [
+              for (var i = 0; i < 4; i++)
+                path('e-race-$round-$i', mode: RawMode.holdHeaders),
+            ];
+            rs = [for (final p in ps) Resolution(cover(p))];
+            await server.until(() => ps.every((p) => server.count(p) == 1));
+            for (final r in rs) {
+              r.cancel();
+            }
+          });
+          await frame(tester);
+          await tester.runAsync(() async {
+            // Headers and the cancellation meet: release everything at once.
+            await Future.wait([
+              for (final p in ps) server.heldFor(p).single.release(),
+            ]);
+            await eventually(() => activeSlots() == 0, 'slots returned');
+          });
+        }
+        await tester.runAsync(() async {
+          final p = path('e-after', shade: 80);
+          final r = Resolution(cover(p));
+          expect(await r.result, isNull, reason: 'process still healthy');
+          r.dispose();
+        });
+      });
+    },
+    skip: !hasNativeHttp,
+    timeout: const Timeout(Duration(minutes: 3)),
+  );
+}
diff --git a/test/network/thumbnail_cover_queue_cache_test.dart b/test/network/thumbnail_cover_queue_cache_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..4efc919aa4ed76626eee9839520afd481678e8b9
--- /dev/null
+++ b/test/network/thumbnail_cover_queue_cache_test.dart
@@ -0,0 +1,172 @@
+// Cache consistency while a cover request waits for a network slot.
+//
+// All 8 slots are held by requests that wait for their headers, so the cover
+// under test is queued. While it waits, the disk cache entry of its key is
+// written by another real path; when it finally gets a slot it must:
+// - use a valid image written in the meantime without any extra request;
+// - not take empty or undecodable bytes for a valid hit;
+// - not use an entry written for another source or cid.
+
+import 'package:flutter/foundation.dart' show Uint8List;
+import 'package:flutter/painting.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:venera/foundation/cache_manager.dart';
+import 'package:venera/foundation/image_provider/cached_image.dart';
+import 'package:venera/network/images.dart';
+
+import 'raw_image_server.dart';
+import 'thumbnail_test_support.dart';
+
+const _limit = 8;
+
+void main() {
+  final unused = CoverServer();
+  final server = RawImageServer();
+  final srcA = testSource('thumb_qc_a');
+  final srcB = testSource('thumb_qc_b');
+
+  setUpAll(() async {
+    await initCoverTestEnvironment(unused, sources: [srcA, srcB]);
+    if (hasNativeHttp) await server.start();
+  });
+
+  tearDownAll(() async {
+    await unused.stop();
+    if (hasNativeHttp) await server.stop();
+  });
+
+  setUp(() => PaintingBinding.instance.imageCache.clear());
+
+  String path(String name, {RawMode mode = RawMode.immediate, int shade = 0}) {
+    final p = '/qc/$name.png';
+    server.images[p] = png(shade, width: 32, height: 32);
+    server.modes[p] = mode;
+    return p;
+  }
+
+  Future<void> eventually(bool Function() condition, String what) async {
+    final sw = Stopwatch()..start();
+    while (!condition()) {
+      if (sw.elapsed > const Duration(seconds: 10)) {
+        fail('timed out waiting for: $what');
+      }
+      await Future<void>.delayed(const Duration(milliseconds: 5));
+    }
+  }
+
+  final limiter = ImageDownloader.coverRequestLimiter;
+
+  /// Holds all slots; returns the held paths.
+  Future<List<String>> fillSlots(String prefix) async {
+    await server.releaseAll();
+    await eventually(() => limiter.active == 0, 'idle limiter');
+    final ps = [
+      for (var i = 0; i < _limit; i++)
+        path('$prefix-held-$i', mode: RawMode.holdHeaders, shade: i),
+    ];
+    for (final p in ps) {
+      Resolution(CachedImageProvider(server.url(p), sourceKey: srcA.key));
+    }
+    await server.until(() => ps.every((p) => server.count(p) == 1));
+    expect(limiter.active, _limit);
+    return ps;
+  }
+
+  Future<void> releaseSlots(List<String> ps) async {
+    for (final p in ps) {
+      await server.heldFor(p).single.release();
+    }
+  }
+
+  testWidgets(
+    'a valid image written while queued is used, no extra request',
+    (tester) async {
+      await tester.runAsync(() async {
+        final held = await fillSlots('e1');
+        final p = path('e1-target', shade: 100);
+        final url = server.url(p);
+        final queued = Resolution(
+          CachedImageProvider(url, sourceKey: srcA.key, cid: 'e1'),
+        );
+        await eventually(() => limiter.waiting >= 1, 'target queued');
+        // Another real write path (the download task's cover loader) stores
+        // the same key while the cover waits.
+        await for (final _ in ImageDownloader.loadThumbnail(
+          url,
+          srcA.key,
+          'e1',
+        )) {}
+        expect(server.count(p), 1);
+        expect(
+          await CacheManager().findCache(thumbDiskKey(url, srcA.key, 'e1')),
+          isNotNull,
+        );
+        await releaseSlots(held);
+        expect(await queued.result, isNull);
+        expect(server.count(p), 1, reason: 'the cached image was used');
+        queued.dispose();
+      });
+    },
+    skip: !hasNativeHttp,
+  );
+
+  for (final (name, bytes) in [
+    ('empty', Uint8List(0)),
+    ('undecodable', corruptPng),
+  ]) {
+    testWidgets(
+      'an $name entry written while queued is not a valid hit',
+      (tester) async {
+        await tester.runAsync(() async {
+          final held = await fillSlots('e2-$name');
+          final p = path('e2-$name-target', shade: 110);
+          final url = server.url(p);
+          final key = thumbDiskKey(url, srcA.key, 'e2');
+          final queued = Resolution(
+            CachedImageProvider(url, sourceKey: srcA.key, cid: 'e2'),
+          );
+          await eventually(() => limiter.waiting >= 1, 'target queued');
+          await CacheManager().writeCache(key, bytes);
+          await releaseSlots(held);
+          expect(
+            await queued.result,
+            isNull,
+            reason: 'loaded from the network',
+          );
+          expect(server.count(p), 1);
+          final file = await CacheManager().findCache(key);
+          expect(await file!.readAsBytes(), server.images[p]);
+          queued.dispose();
+        });
+      },
+      skip: !hasNativeHttp,
+    );
+  }
+
+  testWidgets('an entry for another source or cid is not used', (tester) async {
+    await tester.runAsync(() async {
+      final held = await fillSlots('e3');
+      final p = path('e3-target', shade: 120);
+      final url = server.url(p);
+      final queued = Resolution(
+        CachedImageProvider(url, sourceKey: srcA.key, cid: 'e3'),
+      );
+      await eventually(() => limiter.waiting >= 1, 'target queued');
+      final other = png(121, width: 32, height: 32);
+      await CacheManager().writeCache(thumbDiskKey(url, srcB.key, 'e3'), other);
+      await CacheManager().writeCache(thumbDiskKey(url, srcA.key, 'x'), other);
+      await releaseSlots(held);
+      expect(await queued.result, isNull);
+      expect(server.count(p), 1, reason: 'other keys are not a hit');
+      final own = await CacheManager().findCache(
+        thumbDiskKey(url, srcA.key, 'e3'),
+      );
+      expect(await own!.readAsBytes(), server.images[p]);
+      final b = await CacheManager().findCache(
+        thumbDiskKey(url, srcB.key, 'e3'),
+      );
+      expect(await b!.readAsBytes(), other, reason: 'other entries kept');
+      queued.dispose();
+    });
+  }, skip: !hasNativeHttp);
+}
diff --git a/tool/synthetic_source/README.md b/tool/synthetic_source/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..6021f7f003a0af9d52f3d108f82c0bfd5ab591ce
--- /dev/null
+++ b/tool/synthetic_source/README.md
@@ -0,0 +1,14 @@
+# Yorunote 合成漫畫來源
+
+受控網路驗收用的測試來源與伺服器。所有內容（清單、詳情、章節、封面、閱讀頁）都由程式產生，不含真實漫畫、帳號、Cookie 或閱讀紀錄。
+
+| 檔案 | 用途 |
+|---|---|
+| `serve.dart` | 在電腦啟動伺服器：`dart run tool/synthetic_source/serve.dart [--host H] [--port N] [--public-url URL] [--list-interfaces]` |
+| `synthetic_server.dart` | 伺服器本體（純 `dart:io`），測試也直接匯入 |
+| `yorunote_synthetic_source.js` | 漫畫來源腳本；伺服器在 `/source.js` 提供已填入位址的版本 |
+
+- 綁定非迴路位址時必須給 `--public-url`；工具不猜測區域網路位址。
+- 控制端點與計數：`/__control/*`、`/__stats`、狀態頁 `/`（說明見 `synthetic_server.dart` 開頭）。
+- 雲端驗證：`test/network/synthetic_source_test.dart`（需主機版 `librhttp.so` 與 `libflutter_qjs_plugin.so`）。
+- 實機操作流程：`docs/verification/thumbnail-r2-20261105/ACCEPTANCE_SYNTHETIC.md`。
