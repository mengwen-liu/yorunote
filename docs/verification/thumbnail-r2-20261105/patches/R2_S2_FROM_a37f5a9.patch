new file mode 100644
index 0000000000000000000000000000000000000000..65a91cb586bf246324b624cc640af0eb7af7cf2d
--- /dev/null
+++ b/tool/thumbnail_bench/bench_stats.dart
@@ -0,0 +1,34 @@
+// Summary statistics for the r2 thumbnail benchmark.
+//
+// Definitions (identical to tool/thumbnail_bench/bench_stats.py):
+// - median: middle value for an odd count, mean of the two middle values for
+//   an even count;
+// - percentile p (0..1): linear interpolation between closest ranks on the
+//   sorted values, h = (n - 1) * p (Hyndman & Fan type 7, the default of
+//   NumPy `percentile` and R `quantile`).
+// The r1 benchmark used sorted[round((n - 1) * p)] instead, which for an even
+// count returns the upper of the two middle values as "median".
+
+double median(List<num> xs) => percentile(xs, 0.5);
+
+double percentile(List<num> xs, double p) {
+  if (xs.isEmpty) throw ArgumentError('no values');
+  if (p < 0 || p > 1) throw ArgumentError('p must be within 0..1');
+  final s = [for (final x in xs) x.toDouble()]..sort();
+  final h = (s.length - 1) * p;
+  final lo = h.floor();
+  final hi = h.ceil();
+  return s[lo] + (s[hi] - s[lo]) * (h - lo);
+}
+
+Map<String, dynamic> summary(List<num> xs) {
+  if (xs.isEmpty) return {'n': 0};
+  final s = [for (final x in xs) x.toDouble()]..sort();
+  return {
+    'n': s.length,
+    'median': median(s),
+    'p95': percentile(s, 0.95),
+    'min': s.first,
+    'max': s.last,
+  };
+}
diff --git a/tool/thumbnail_bench/bench_stats.py b/tool/thumbnail_bench/bench_stats.py
new file mode 100644
index 0000000000000000000000000000000000000000..6dbaffbe706a00992705485ed1f0d551398fabb2
--- /dev/null
+++ b/tool/thumbnail_bench/bench_stats.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""Summary statistics for the thumbnail benchmark (same as bench_stats.dart).
+
+median: middle value (odd n) or mean of the two middle values (even n).
+percentile p in [0, 1]: linear interpolation, h = (n - 1) * p
+(Hyndman & Fan type 7; NumPy `percentile` default, R `quantile` default).
+r1_rank(p): the r1 rule sorted[round((n - 1) * p)], kept only to explain
+old numbers. Note Dart rounds .5 away from zero, Python rounds half to even;
+r1_rank therefore uses floor(x + 0.5) to match Dart.
+
+Run `python3 -I bench_stats.py --self-test` to check the known values.
+"""
+import math
+import sys
+
+
+def percentile(xs, p):
+    if not xs:
+        raise ValueError("no values")
+    s = sorted(float(x) for x in xs)
+    h = (len(s) - 1) * p
+    lo, hi = math.floor(h), math.ceil(h)
+    return s[lo] + (s[hi] - s[lo]) * (h - lo)
+
+
+def median(xs):
+    return percentile(xs, 0.5)
+
+
+def r1_rank(xs, p):
+    s = sorted(float(x) for x in xs)
+    return s[math.floor((len(s) - 1) * p + 0.5)]
+
+
+def summary(xs):
+    s = sorted(float(x) for x in xs)
+    return {"n": len(s), "median": median(s), "p95": percentile(s, 0.95),
+            "min": s[0], "max": s[-1]}
+
+
+def self_test():
+    assert median([5, 1, 3]) == 3
+    assert median([4, 1, 3, 2]) == 2.5
+    assert median([10, 20]) == 15
+    xs = list(range(1, 11))
+    assert percentile(xs, 0) == 1 and percentile(xs, 1) == 10
+    assert abs(percentile(xs, 0.95) - 9.55) < 1e-9
+    assert abs(percentile(xs, 0.25) - 3.25) < 1e-9
+    assert abs(percentile([15, 20, 35, 40, 50], 0.4) - 29) < 1e-9
+    assert r1_rank([1, 2, 3, 4], 0.5) == 3
+    # Dart's round(1.5) == 2, round(2.5) == 3 (away from zero).
+    assert r1_rank([1, 2, 3, 4, 5, 6], 0.5) == 4
+    print("bench_stats self-test: OK")
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["--self-test"]:
+        self_test()
