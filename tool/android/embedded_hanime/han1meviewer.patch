index 0000000..94c0beb
--- /dev/null
+++ b/app/src/test/java/com/yenaly/han1meviewer/EmbeddedHanimeTest.kt
@@ -0,0 +1,27 @@
+package com.yenaly.han1meviewer
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class EmbeddedHanimeTest {
+    @get:Rule val temporary = TemporaryFolder()
+
+    @Test fun namespacesDoNotUseHostNames() {
+        assertEquals("yorunote_han1me_history.db", EmbeddedHanime.databaseName("history.db"))
+        assertEquals("yorunote_han1me.download.42", EmbeddedHanime.downloadWorkName("42"))
+        assertEquals("yorunote_han1me_preferences", EmbeddedHanime.PREFERENCES)
+    }
+
+    @Test fun downloadDirectoryRejectsEscapeSegments() {
+        val root = temporary.newFolder()
+        assertEquals(root.resolve("42"), EmbeddedHanime.downloadFolder(root, "42"))
+        for (segment in listOf("", "..", "../comic", "other/comic", "other\\comic", "C:host")) {
+            assertThrows(IllegalArgumentException::class.java) {
+                EmbeddedHanime.downloadFolder(root, segment)
+            }
+        }
+    }
+}
