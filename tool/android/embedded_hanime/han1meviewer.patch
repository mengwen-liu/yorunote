index 0000000..21a4aea
--- /dev/null
+++ b/app/src/main/java/com/yenaly/han1meviewer/EmbeddedHanime.kt
@@ -0,0 +1,82 @@
+package com.yenaly.han1meviewer
+
+import android.app.Application
+import android.content.Context
+import android.os.Environment
+import android.os.Looper
+import android.widget.Toast
+import androidx.core.app.NotificationChannelCompat
+import androidx.core.app.NotificationManagerCompat
+import com.yenaly.han1meviewer.util.AnimeShaders
+import com.yenaly.yenaly_libs.base.YenalyInitializer
+import com.yenaly.yenaly_libs.utils.applicationContext
+import `is`.xyz.mpv.MPVLib
+import java.io.File
+import okio.Path.Companion.toPath
+
+object EmbeddedHanime {
+    internal const val PREFERENCES = "yorunote_han1me_preferences"
+    private const val DIRECTORY = "yorunote_han1me"
+    internal val imageLoader by lazy {
+        val context = applicationContext
+        coil3.ImageLoader.Builder(context)
+            .diskCache {
+                coil3.disk.DiskCache.Builder()
+                    .directory(File(cacheDir(context), "images").absolutePath.toPath())
+                    .build()
+            }
+            .build()
+    }
+
+    private var initialization: Result<Unit>? = null
+
+    /** Main-thread entry for the host and for Android task restoration. */
+    @JvmStatic
+    fun initialize(context: Context) {
+        check(Looper.myLooper() == Looper.getMainLooper())
+        val app = context.applicationContext as Application
+        val result = initialization ?: runCatching {
+            initializeContext(app)
+            check(AnimeShaders.copyShaderAssets(app) > 0) { "Han1meViewer shader assets unavailable" }
+            check(AnimeShaders.copyCertAssets(app) > 0) { "Han1meViewer certificate bundle unavailable" }
+            NotificationManagerCompat.from(app).createNotificationChannel(
+                NotificationChannelCompat.Builder(
+                    DOWNLOAD_NOTIFICATION_CHANNEL, NotificationManagerCompat.IMPORTANCE_HIGH,
+                ).setName("Han1meViewer downloads").build(),
+            )
+            MPVLib.create(app)
+            MPVLib.init()
+        }.also { initialization = it }
+        result.getOrThrow()
+    }
+
+    internal fun initializeContext(context: Context) {
+        YenalyInitializer().create(context.applicationContext)
+    }
+
+    internal fun preferences(context: Context) =
+        context.getSharedPreferences(PREFERENCES, Context.MODE_PRIVATE)
+
+    internal fun cacheDir(context: Context) = File(context.cacheDir, DIRECTORY)
+    internal fun filesDir(context: Context) = File(context.filesDir, DIRECTORY)
+    internal fun downloadDir(context: Context): File =
+        context.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS)
+            ?.let { File(it, DIRECTORY) }
+            ?: File(filesDir(context), "downloads")
+
+    internal fun databaseName(name: String) = "${DIRECTORY}_$name"
+    internal fun downloadWorkName(videoCode: String) = "$DIRECTORY.download.$videoCode"
+
+    internal fun downloadFolder(root: File, videoCode: String): File {
+        require(videoCode.isNotBlank() && videoCode != "." && videoCode != ".." &&
+            videoCode.none { it == '/' || it == '\\' || it == ':' || it.code < 32 })
+        val base = root.canonicalFile
+        val child = File(base, videoCode).canonicalFile
+        require(child.parentFile == base) { "Download path is outside the Han1meViewer directory" }
+        return child
+    }
+
+    internal fun unavailable(context: Context) {
+        Toast.makeText(context, R.string.embedded_feature_unavailable, Toast.LENGTH_SHORT).show()
+    }
+}
